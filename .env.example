NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_WORLDID_APP_ID=
WORLDID_RP_ID=
WORLDID_SIGNING_KEY=
WORLDID_ACTION=verimesh-authorize
ZEROG_RPC=https://evmrpc-testnet.0g.ai
ZEROG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_PRIVATE_KEY=
ZEROG_COMPUTE_PROVIDER=
LLM_PROVIDER=zerog
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Comma-separate several endpoints to fail over when one is unhealthy; the agent
# rotates to the next one on each broadcast attempt and never re-sends a tx it
# already broadcast.
REGISTRY_CHAIN_RPC=https://sepolia.base.org
REGISTRY_CHAIN_ID=84532
REGISTRY_ADDRESS=0x0Fb557580E7C01Aed5D02622558216B9eb19c33c
REGISTRY_START_BLOCK=44613204
REGISTRY_PRIVATE_KEY=
REGISTRY_EXPLORER=https://sepolia.basescan.org
# The subgraph is hosted on Goldsky, not Subgraph Studio. Studio's development
# query URL is the only endpoint a testnet subgraph can have (publishing to the
# decentralized network is mainnet-only) and it is rate limited hard enough that
# the agent loop and the audit views compete for the same budget. Goldsky's free
# Starter tier has no query quota at all — only a 20-requests-per-10-seconds
# burst limit, which is ~100x our steady-state load. Same manifest, same
# mappings, same base-sepolia slug; only the host changed.
#
# Fill this from `pnpm --dir subgraph goldsky:status` after the first deploy.
# The `/prod` tag is a stable alias — redeploying 1.0.0 under the same tag keeps
# this URL valid, which the Studio version-pinned URL never did.
SUBGRAPH_URL=https://api.goldsky.com/api/public/project_<PROJECT_ID>/subgraphs/verimesh-base-sepolia/prod/gn
SUBGRAPH_DEPLOY_KEY=
NEXT_PUBLIC_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_<PROJECT_ID>/subgraphs/verimesh-base-sepolia/prod/gn
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0Fb557580E7C01Aed5D02622558216B9eb19c33c
GRAPH_MCP_ENDPOINT=http://127.0.0.1:8787
AGENT_MODE=full
AGENT_LOOP_MS=8000
SIM_INTERVAL_MS=5000
SIM_FAULTS=
HISTORY_VIA_MCP=0
MCP_PORT=8787
# Lets `agent approve` and `run-scenario --auto-approve` fill a quorum slot with a
# fabricated signer, so the freeze branch can be tested without two phones. It proves
# nothing about personhood. Every such approval is written into `events` as SIMULATED.
# MUST stay false on the demo machine — there, every signature comes from a real scan.
# It also gates POST /api/demo/approve, which is the browser-side equivalent.
ALLOW_SIMULATED_APPROVALS=false
# Turns on the public self-serve demo: the "Simulate failure" control in the top bar
# (POST /api/demo/scenario, /api/demo/reset) and, in the freeze modal, a simulated
# approval button INSTEAD of the World ID scan. Off means the modal only accepts a
# real Orb scan. Read by both the browser and the server, so it is NEXT_PUBLIC_.
# Leave false on the demo machine.
NEXT_PUBLIC_DEMO_MODE=false
# The fabricated signers demo mode enrols, as operator:nullifier pairs. They are
# merged into the operator allowlist ONLY while NEXT_PUBLIC_DEMO_MODE=true, so the
# committed authz_config.json is never edited to make the demo pass. Leave unset and
# each operator gets sha256("verimesh-simulated-signer:<operator>") — the same value
# the `agent approve` CLI has always used. The agent needs this too: it is the agent
# that resolves the gate against the allowlist.
DEMO_SIGNER_NULLIFIERS=
DEVICE_TOKEN=
DEVICE_OPERATOR=opC
DEVICE_LABEL=Galaxy S22
# Temperature is measured, stored and displayed, but does not classify: a phone
# battery moves ~2.5C over a burst and sheds it over minutes, so any bound low
# enough to cross leaves the node stuck above it. Contention is the trigger.
# Set true only on hardware whose thermals actually move. See TASKS/DEVICE-NODE.md
DEVICE_TEMP_GATES=false
DEVICE_T_WARN=36
DEVICE_T_MAX=40
# NOT 0.85. On handsets that deny /proc/stat, load is scheduler contention,
# which idles ~0.08 and peaks ~0.40 under a 16-worker burst — it never
# approaches the ~1.0 that a utilisation figure would.
DEVICE_L_MAX=0.28
DEVICE_X_NOMINAL=1000
DEVICE_OWNS_STATUS=true
NEXT_PUBLIC_DEVICE_NODE_ID=device-s22
NEXT_PUBLIC_DEVICE_STALE_MS=8000
