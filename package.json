{
  "name": "verimesh",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance": "pnpm --filter @verimesh/verifier snapshot --from 44613204 --out ../../chain-snapshot.json && pnpm --filter @verimesh/verifier acceptance --input ../../chain-snapshot.json"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "fast-check": "^4.9.0",
    "solc": "0.8.28",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
